<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexQuota.Controls.CodexUsagePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel x:Name="Root" Spacing="10" MinWidth="300">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Path x:Name="LogoPath"
                  Width="30"
                  Height="30"
                  Stretch="Uniform"
                  UseLayoutRounding="True"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="ProviderName" Text="Codex"
                               FontWeight="SemiBold"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlanText"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               FontWeight="SemiBold"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="EmailText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">
                <ToggleButton x:Name="SettingsButton"
                        Width="32"
                        Height="32"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        CornerRadius="4"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="FlyoutSettingsButton"
                        Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                </ToggleButton>
                <Button x:Name="RefreshButton"
                        Width="32"
                        Height="32"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.AutomationId="FlyoutRefreshButton"
                        Click="RefreshButton_Click">
                    <FontIcon Glyph="&#xE72C;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
                <Button x:Name="CloseButton"
                        Width="32"
                        Height="32"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.AutomationId="FlyoutCloseButton"
                        Click="CloseButton_Click">
                    <FontIcon Glyph="&#xE711;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="UsageRows" Spacing="8"/>

        <StackPanel x:Name="ProfileSection"
                    Spacing="4"
                    Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="TokenActivityText"
                           Style="{StaticResource BodyTextBlockStyle}"/>
                <TextBlock x:Name="ProfileAsOfText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel x:Name="ActivityColumns"
                        Orientation="Horizontal"
                        Spacing="3"/>
            <TextBlock x:Name="ActivityDetailText"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <TextBlock x:Name="UpdatedText"
                   HorizontalAlignment="Stretch"
                   TextAlignment="Right"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</UserControl>
