<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexQuota.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodexQuota.Controls">

    <Grid x:Name="Root" CornerRadius="8">
        <ScrollViewer Padding="16,14,16,4"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <controls:CodexUsagePanel x:Name="UsagePanel"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- The appearance section floats over the usage content (same grid cell, drawn on top): it
             never contributes to the flyout height, and the window does not grow or shrink when it
             reveals. -->
        <StackPanel x:Name="AppearanceSection"
                    Margin="16,6,16,12"
                    Spacing="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    CornerRadius="4"
                    Visibility="Collapsed">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="AppearanceSectionTransform"/>
            </StackPanel.RenderTransform>
            <Border Height="1"
                    Margin="0,2,0,4"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Left">
                <CheckBox x:Name="ShowIconCheck"
                          Content="Icon"
                          FontSize="12"
                          MinHeight="20"
                          Padding="0"
                          VerticalContentAlignment="Center"
                          MinWidth="0"
                          VerticalAlignment="Center"
                          Checked="AppearanceCheck_Checked"
                          Unchecked="AppearanceCheck_Unchecked"
                          ToolTipService.ToolTip="Show the Codex badge in the taskbar tile"/>
                <CheckBox x:Name="ShowProgressBarCheck"
                          Content="Bars"
                          FontSize="12"
                          MinHeight="20"
                          Padding="0"
                          VerticalContentAlignment="Center"
                          MinWidth="0"
                          VerticalAlignment="Center"
                          Checked="AppearanceCheck_Checked"
                          Unchecked="AppearanceCheck_Unchecked"
                          ToolTipService.ToolTip="Show progress bars in the taskbar tile; percentages always stay"/>
                <CheckBox x:Name="ColorCodeTextCheck"
                          Content="Color %"
                          FontSize="12"
                          MinHeight="20"
                          Padding="0"
                          VerticalContentAlignment="Center"
                          MinWidth="0"
                          VerticalAlignment="Center"
                          Checked="AppearanceCheck_Checked"
                          Unchecked="AppearanceCheck_Unchecked"
                          ToolTipService.ToolTip="Color the remaining percent: orange at 50% or less, red at 20% or less"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0">
                <TextBlock x:Name="WarnBelowText"
                           Text="Warn below %"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"/>
                <NumberBox x:Name="WarnUpperBox"
                           Value="50"
                           Minimum="1"
                           Maximum="99"
                           SmallChange="5"
                           Width="64"
                           SpinButtonPlacementMode="Compact"
                           ValueChanged="WarnThresholdBox_ValueChanged"
                           ToolTipService.ToolTip="Caution (orange) below this remaining percent"/>
                <NumberBox x:Name="WarnLowerBox"
                           Value="20"
                           Minimum="0"
                           Maximum="99"
                           SmallChange="5"
                           Width="64"
                           SpinButtonPlacementMode="Compact"
                           ValueChanged="WarnThresholdBox_ValueChanged"
                           ToolTipService.ToolTip="Critical (red) below this remaining percent"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Left">
                <TextBlock x:Name="WorkdayHoursText"
                           Text="Workday hours"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"/>
                <NumberBox x:Name="WorkdayHoursBox"
                           Value="8"
                           Minimum="1"
                           Maximum="24"
                           SmallChange="1"
                           Width="64"
                           SpinButtonPlacementMode="Compact"
                           ValueChanged="WorkdayHoursBox_ValueChanged"
                           ToolTipService.ToolTip="Assumed coding hours in each 24-hour quota day"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
